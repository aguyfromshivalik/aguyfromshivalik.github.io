<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {% if item.inline %}
                {% assign news_has_photo = false %}
                {% unless include.hide_photos %}
                  {% if item.images and item.images.size > 0 %}
                    {% assign news_has_photo = true %}
                  {% elsif item.image %}
                    {% assign news_has_photo = true %}
                  {% endif %}
                {% endunless %}
                <div class="news-item{% if news_has_photo %} news-item-has-photo{% endif %}">
                  {% if news_has_photo %}
                    <div class="news-item-photos">
                      {% if item.images and item.images.size > 0 %}
                        {% for img_entry in item.images %}
                          {% if img_entry.path %}
                            {% assign news_img = img_entry.path %}
                            {% assign news_alt = img_entry.alt | default: '' %}
                          {% else %}
                            {% assign news_img = img_entry %}
                            {% assign news_alt = '' %}
                          {% endif %}
                          {% unless news_img contains '://' or news_img contains '/assets/' %}
                            {% assign news_img = '/assets/img/' | append: news_img %}
                          {% endunless %}
                          <button
                            type="button"
                            class="news-item-thumb"
                            data-news-lightbox-src="{{ news_img | relative_url }}"
                            data-news-lightbox-alt="{{ news_alt | escape }}"
                            aria-label="Open photo"
                          >
                            <img
                              class="news-item-img"
                              src="{{ news_img | relative_url }}"
                              alt="{{ news_alt }}"
                              loading="lazy"
                            >
                          </button>
                        {% endfor %}
                      {% else %}
                        {% assign news_img = item.image %}
                        {% unless news_img contains '://' or news_img contains '/assets/' %}
                          {% assign news_img = '/assets/img/' | append: news_img %}
                        {% endunless %}
                        <button
                          type="button"
                          class="news-item-thumb"
                          data-news-lightbox-src="{{ news_img | relative_url }}"
                          data-news-lightbox-alt="{{ item.image_alt | default: '' | escape }}"
                          aria-label="Open photo"
                        >
                          <img
                            class="news-item-img"
                            src="{{ news_img | relative_url }}"
                            alt="{{ item.image_alt | default: '' }}"
                            loading="lazy"
                          >
                        </button>
                      {% endif %}
                    </div>
                  {% endif %}
                  <div class="news-item-text">
                    {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                  </div>
                </div>
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>

    <div class="news-lightbox" hidden>
      <button type="button" class="news-lightbox-backdrop" aria-label="Close photo"></button>
      <div class="news-lightbox-dialog" role="dialog" aria-modal="true" aria-label="News photo">
        <div class="news-lightbox-stage">
          <button type="button" class="news-lightbox-nav news-lightbox-prev" aria-label="Previous photo" hidden>‹</button>
          <img class="news-lightbox-img" src="" alt="">
          <button type="button" class="news-lightbox-nav news-lightbox-next" aria-label="Next photo" hidden>›</button>
        </div>
        <button type="button" class="news-lightbox-close" aria-label="Close photo">Close</button>
      </div>
    </div>

    <script>
      (function () {
        var roots = document.querySelectorAll('.news');
        roots.forEach(function (root) {
          if (root.dataset.newsLightboxReady) return;
          root.dataset.newsLightboxReady = '1';

          var lightbox = root.querySelector('.news-lightbox');
          var lightboxImg = root.querySelector('.news-lightbox-img');
          var closeBtn = root.querySelector('.news-lightbox-close');
          var backdrop = root.querySelector('.news-lightbox-backdrop');
          var prevBtn = root.querySelector('.news-lightbox-prev');
          var nextBtn = root.querySelector('.news-lightbox-next');
          var thumbs = root.querySelectorAll('.news-item-thumb');
          if (!lightbox || !lightboxImg || !thumbs.length) return;

          var gallery = [];
          var index = 0;

          function showSlide(i) {
            if (!gallery.length) return;
            index = (i + gallery.length) % gallery.length;
            lightboxImg.src = gallery[index].src;
            lightboxImg.alt = gallery[index].alt || '';
          }

          function setNavVisible(show) {
            if (prevBtn) prevBtn.hidden = !show;
            if (nextBtn) nextBtn.hidden = !show;
          }

          function openLightbox(items, startIndex) {
            gallery = items;
            index = startIndex || 0;
            showSlide(index);
            setNavVisible(gallery.length > 1);
            lightbox.hidden = false;
            document.body.classList.add('news-lightbox-open');
          }

          function closeLightbox() {
            lightbox.hidden = true;
            lightboxImg.removeAttribute('src');
            lightboxImg.alt = '';
            gallery = [];
            setNavVisible(false);
            document.body.classList.remove('news-lightbox-open');
          }

          thumbs.forEach(function (thumb) {
            thumb.addEventListener('click', function () {
              var group = thumb.closest('.news-item-photos');
              var groupThumbs = group
                ? Array.prototype.slice.call(group.querySelectorAll('.news-item-thumb'))
                : [thumb];
              var items = groupThumbs.map(function (t) {
                return {
                  src: t.dataset.newsLightboxSrc,
                  alt: t.dataset.newsLightboxAlt || '',
                };
              });
              openLightbox(items, groupThumbs.indexOf(thumb));
            });
          });

          if (prevBtn) {
            prevBtn.addEventListener('click', function (e) {
              e.stopPropagation();
              showSlide(index - 1);
            });
          }
          if (nextBtn) {
            nextBtn.addEventListener('click', function (e) {
              e.stopPropagation();
              showSlide(index + 1);
            });
          }
          if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
          if (backdrop) backdrop.addEventListener('click', closeLightbox);

          document.addEventListener('keydown', function (e) {
            if (lightbox.hidden) return;
            if (e.key === 'Escape') {
              e.preventDefault();
              closeLightbox();
            } else if (e.key === 'ArrowLeft' && gallery.length > 1) {
              e.preventDefault();
              showSlide(index - 1);
            } else if (e.key === 'ArrowRight' && gallery.length > 1) {
              e.preventDefault();
              showSlide(index + 1);
            }
          });
        });
      })();
    </script>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
